# ===== REQUIRED: Supabase Configuration =====
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
# Must be the PUBLIC "anon" key (JWT payload role = "anon"). NOT the service_role key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# Server-only key (NEVER expose to client, NEVER give it a NEXT_PUBLIC_ prefix)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ===== REQUIRED: Midtrans Payment Gateway =====
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=your-midtrans-client-key
MIDTRANS_SERVER_KEY=your-midtrans-server-key
NEXT_PUBLIC_MIDTRANS_ENV=sandbox

# ===== SECURITY: Admin Authentication =====
# Username for admin login (CHANGE IN PRODUCTION)
ADMIN_USERNAME=
# Password for admin login (CHANGE IN PRODUCTION)
ADMIN_PASSWORD=
# Secret used to sign the admin session cookie (HMAC-SHA256). Min 16 chars. (CHANGE IN PRODUCTION)
ADMIN_AUTH_SECRET=

# ===== OPTIONAL: Biteship Shipping API =====
# Only required if using Biteship integration
BITESHIP_API_KEY=biteship_test.xxx-your-test-api-key-xxx

# ===== OPTIONAL: Biteship Shipper Configuration =====
# Only required if using Biteship integration
BITESHIP_SHIPPER_NAME=Your Store Name
BITESHIP_SHIPPER_EMAIL=your-email@example.com
BITESHIP_SHIPPER_PHONE=+62812345678
BITESHIP_SHIPPER_ADDRESS=Jl. Your Address No. 1
BITESHIP_SHIPPER_POSTAL=12345
BITESHIP_SHIPPER_CITY=Your City

# ===== OPTIONAL: Biteship Courier Settings =====
# Only required if using Biteship integration
BITESHIP_COURIER_COMPANY=jne
BITESHIP_COURIER_TYPE=reg
BITESHIP_DELIVERY_TYPE=now
# ===== OPTIONAL: Biteship Webhook Security =====
# Only required if using Biteship webhooks. The header name (Headers Signature
# Key) and secret value (Headers Signature Secret) configured in the Biteship
# dashboard. REQUIRED in production: without them the webhook is fail-closed
# (real payloads are rejected) to prevent forged status updates.
BITESHIP_WEBHOOK_SIGNATURE_HEADER=x-biteship-signature
BITESHIP_WEBHOOK_SIGNATURE_SECRET=

# ===== OPTIONAL: Custom Shipping Rates =====
# Override default flat rates (in IDR)
SHIPPING_RATE_JAKARTA=15000
SHIPPING_RATE_BANDUNG=17000
SHIPPING_RATE_SURABAYA=19000
SHIPPING_RATE_LUAR_JAWA=25000

# ===== OPTIONAL: Resend Email Service =====
# Used for contact form notifications. Get your API key at https://resend.com
RESEND_API_KEY=your_resend_api_key_here

# ===== REQUIRED: WhatsApp Notification (Fonnte) =====
# Get your API key at https://fonnte.com
FONNTE_API_KEY=your-fonnte-api-key-here

# ===== Site Configuration =====
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NODE_ENV=development
